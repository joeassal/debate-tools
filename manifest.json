{
    "manifest_version": 3,
    "name": "Copy Logger",
    "version": "1.0",
    "host_permissions": [
        "https://docs.google.com/document/d/*",
        "https://opencaselist.com/*"
    ],
    "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://docs.google.com/document/d/*"],
            "js": ["utils.js", "folder-tree.js", "sidebar.js", "content.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "side_panel": {
        "default_path": "flow.html"
    }
}
