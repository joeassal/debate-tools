{
    "manifest_version": 3,
    "name": "CardFlow - Debate Tools for Google Docs",
    "description": "A set of tools to help competitive debaters use Google Docs more effectively, similar to Verbatim but for google docs",
    "version": "1.0.1",
    "host_permissions": [
        "https://docs.google.com/document/d/*",
        "https://opencaselist.com/*"
    ],
    "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "debugger",
    "tabs",
    "scripting",
    "sidePanel"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "128": "icons/icon128.png",
        "48": "icons/icon48.png"
    },
    "content_scripts": [
        {
            "matches": ["https://docs.google.com/document/d/*"],
            "js": ["utils.js", "folder-tree.js", "sidebar.js", "content.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "side_panel": {
        "default_path": "flow.html"
    }
}